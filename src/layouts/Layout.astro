---
import '~/assets/styles/tailwind.css';

import { I18N } from 'astrowind:config';
import { ClientRouter } from 'astro:transitions';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import Metadata from '~/components/common/Metadata.astro';
import LeadConnectorWidget from '~/components/integrations/LeadConnectorWidget.astro';

import type { MetaData as MetaDataType } from '~/types';

export interface Props {
  metadata?: MetaDataType;
  chat?: boolean;
}

const { metadata = {}, chat = true } = Astro.props;
const { language, textDirection } = I18N;
---

<!doctype html>
<html lang={language} dir={textDirection}>
  <head>
    <CommonMeta />
    <Favicons />
    <CustomStyles />
    <Metadata {...metadata} />
    <ClientRouter />
  </head>

  <body>
    <slot />
    <script>
      import '~/scripts/mobile-app-deck';
      import '~/scripts/motion';
      import '~/scripts/site-shell';
      import '~/scripts/quote-wizard';
    </script>
    <LeadConnectorWidget allowed={chat} />
  </body>
</html>
