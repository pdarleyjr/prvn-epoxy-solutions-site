---
import Layout from '~/layouts/PageLayout.astro';

import type { MetaData } from '~/types';

export interface Props {
  frontmatter: {
    title?: string;
    download?: string;
  };
  getHeadings: () => { depth: number; slug: string; text: string }[];
}

const { frontmatter } = Astro.props;
const headings = Astro.props.getHeadings().filter((heading) => heading.depth === 2);

const metadata: MetaData = {
  title: frontmatter?.title,
};
---

<Layout metadata={metadata}>
  <section class="page-hero">
    <article class="shell card legal-copy">
      <h1>{frontmatter.title}</h1>
      <nav aria-label="Legal documents" class="legal-links">
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms of Service</a>
        {
          frontmatter.download && (
            <a href={frontmatter.download} download>
              Download PDF
            </a>
          )
        }
      </nav>
      <details class="legal-contents">
        <summary>On this page</summary>
        <ul>
          {
            headings.map((heading) => (
              <li>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))
          }
        </ul>
      </details>
      <slot />
    </article>
  </section>
</Layout>
