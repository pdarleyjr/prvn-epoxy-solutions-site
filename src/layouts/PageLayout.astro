---
import Layout from '~/layouts/Layout.astro';
import Logo from '~/components/Logo.astro';
import { headerData, footerData } from '~/navigation';
import { business } from '~/data/site';

import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
}

const { metadata } = Astro.props;
---

<Layout metadata={metadata}>
  <header class="site-header" data-site-header>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="nav-shell">
      <a class="brand-link" href="/" aria-label="PRVN Epoxy Solutions home" transition:name="site-logo">
        <Logo />
      </a>

      <nav id="primary-navigation" class="site-nav" aria-label="Primary navigation" data-site-nav>
        {
          headerData.links.map((link) => (
            <a href={link.href} class:list={[Astro.url.pathname === link.href ? 'is-active' : '']}>
              {link.text}
            </a>
          ))
        }
      </nav>

      <div class="nav-actions">
        <a class="phone-link" href={business.phoneHref} data-cta="call">{business.phoneDisplay}</a>
        {
          headerData.actions.map((action) => (
            <a class="button button-small" href={action.href} data-cta="quote" data-magnetic>
              {action.text}
            </a>
          ))
        }
      </div>

      <button
        class="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-drawer"
        aria-label="Open navigation"
        data-nav-toggle
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </header>

  <div
    class="mobile-drawer"
    id="mobile-drawer"
    data-mobile-drawer
    role="dialog"
    aria-modal="true"
    aria-label="Site navigation"
    aria-hidden="true"
  >
    <div class="mobile-drawer-backdrop" data-drawer-close></div>
    <div class="mobile-drawer-panel">
      <div class="mobile-drawer-header">
        <Logo />
        <button class="mobile-drawer-close" type="button" data-drawer-close aria-label="Close navigation">
          &times;
        </button>
      </div>
      <nav class="mobile-drawer-nav" aria-label="Mobile navigation">
        <a href="/" class:list={[Astro.url.pathname === '/' ? 'is-active' : '']}>Home</a>
        {
          headerData.links.map((link) => (
            <a href={link.href} class:list={[Astro.url.pathname === link.href ? 'is-active' : '']}>
              {link.text}
            </a>
          ))
        }
      </nav>
      <div class="mobile-drawer-actions">
        <a class="button" href="/quote" data-cta="quote">Start a Quote</a>
        <a class="button button-secondary" href={business.phoneHref} data-cta="call">Call {business.phoneDisplay}</a>
        <a class="button button-secondary" href={business.smsHref} data-cta="text">Text PRVN</a>
      </div>
    </div>
  </div>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="footer-grid shell">
      <div class="footer-brand">
        <Logo />
        <p>{business.tagline}</p>
        <p class="footer-note">{footerData.footNote}</p>
      </div>
      {
        footerData.links.map((group) => (
          <div class="footer-column">
            <h2>{group.title}</h2>
            {group.links.map((link) => (
              <a
                href={link.href}
                data-cta={link.href.startsWith('tel:') ? 'call' : link.href.startsWith('sms:') ? 'text' : undefined}
              >
                {link.text}
              </a>
            ))}
          </div>
        ))
      }
    </div>
    <div class="footer-bottom shell">
      <p>Copyright {new Date().getFullYear()} PRVN Epoxy Solutions. All rights reserved.</p>
      <div>
        {footerData.secondaryLinks.map((link) => <a href={link.href}>{link.text}</a>)}
      </div>
    </div>
  </footer>

  <div class="conversion-dock" data-conversion-dock>
    <a href={business.phoneHref} data-cta="call" aria-label="Call PRVN">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path
          d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
        ></path>
      </svg>
      Call
    </a>
    <a href={business.smsHref} data-cta="text" aria-label="Text PRVN">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
      </svg>
      Text
    </a>
    <a href="/quote" data-cta="quote" class="dock-primary" aria-label="Get a quote">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
        <polyline points="14 2 14 8 20 8"></polyline>
        <line x1="16" y1="13" x2="8" y2="13"></line>
        <line x1="16" y1="17" x2="8" y2="17"></line>
        <polyline points="10 9 9 9 8 9"></polyline>
      </svg>
      Get Quote
    </a>
  </div>
</Layout>
