---
import { galleryFilters, galleryImages } from '~/data/site';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Epoxy Floor Gallery',
  description:
    'Browse PRVN Epoxy Solutions gallery images for flakes, quartz, metallic, and solid epoxy floor finishes.',
};
---

<Layout metadata={metadata}>
  <section class="page-hero" data-section="gallery-hero">
    <div class="shell section-heading" data-reveal>
      <span class="kicker">Gallery</span>
      <h1>Current PRVN gallery.</h1>
      <p>
        A focused finish gallery for Flakes, Quartz, Metallic, and Solid epoxy looks, arranged so each image keeps its
        natural shape without awkward cropping.
      </p>
      <a class="button" href="/quote" data-cta="quote" data-magnetic>Request this look</a>
    </div>
  </section>

  <section class="section" data-section="gallery">
    <div class="shell gallery-shell" data-gallery>
      <div class="gallery-filters" aria-label="Gallery filters">
        {
          galleryFilters.map((filter) => (
            <button
              class="filter-button"
              type="button"
              data-gallery-filter={filter.id}
              aria-pressed={filter.id === 'all' ? 'true' : 'false'}
            >
              {filter.label}
            </button>
          ))
        }
      </div>

      <div class="gallery-grid gallery-grid-full">
        {
          galleryImages.map((image) => (
            <button
              class="gallery-item"
              type="button"
              data-gallery-item
              data-full={image.full}
              data-alt={image.alt}
              data-caption={image.caption}
              data-badge={image.badge}
              data-categories={image.categories.join(',')}
              data-reveal
            >
              <img
                src={image.src}
                alt={image.alt}
                loading="lazy"
                decoding="async"
                width={image.width}
                height={image.height}
              />
              <span>{image.badge}</span>
            </button>
          ))
        }
      </div>

      <p class="gallery-empty" data-gallery-empty hidden>
        No image is available for this finish yet. PRVN can add more photos as they become available.
      </p>
    </div>
  </section>
</Layout>
