---
import { galleryImages } from '~/data/site';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Epoxy Floor Gallery',
  description: 'Preview current PRVN Epoxy Solutions project and concept imagery for epoxy floor finishes.',
};
---

<Layout metadata={metadata}>
  <section class="page-hero">
    <div class="shell section-heading">
      <span class="kicker">Gallery</span>
      <h1>Current PRVN gallery.</h1>
      <p>
        A focused set of current project and concept images, arranged in a masonry layout so each file keeps its natural
        shape without awkward cropping.
      </p>
      <a class="button" href="/quote">Request this look</a>
    </div>
  </section>

  <section class="section">
    <div class="shell gallery-grid">
      {galleryImages.map((image) => <img src={image.src} alt={image.alt} loading="lazy" decoding="async" />)}
    </div>
  </section>
</Layout>
