---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Page Not Found',
  robots: { index: false, follow: false },
};
---

<Layout metadata={metadata}>
  <section class="page-hero">
    <div class="shell section-heading">
      <span class="kicker">404</span>
      <h1>This slab is not on the plan.</h1>
      <p>The page may have moved, or the link may be unfinished. Head back to the PRVN homepage or start a quote.</p>
      <div class="inline-actions">
        <a class="button" href="/">Back home</a>
        <a class="button button-secondary" href="/quote">Start quote</a>
      </div>
    </div>
  </section>
</Layout>
