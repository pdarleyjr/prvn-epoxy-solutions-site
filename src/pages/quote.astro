---
import { business, finishFamilies, services } from '~/data/site';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Free Epoxy Floor Quote',
  description:
    'Request a PRVN Epoxy Solutions quote for premium epoxy floors from the Florida Keys to West Palm Beach.',
};

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<Layout metadata={metadata}>
  <section class="page-hero" data-section="quote-hero">
    <div class="shell section-heading" data-reveal>
      <span class="kicker">Free quote</span>
      <h1>Tell PRVN what the concrete needs to become.</h1>
      <p>
        Walk through a few quick steps to share your project details. If the web form is unavailable, call or text PRVN
        directly.
      </p>
    </div>
  </section>

  <section class="section" data-section="quote-form">
    <div class="shell">
      <div class="quote-wizard-desktop">
        <aside class="wizard-sidebar" data-reveal>
          <div class="contact-card">
            <span class="kicker">What helps</span>
            <h2>Photos make the estimate sharper.</h2>
            <p>
              Include square footage, slab photos, finish preference, timeline, and whether the space has existing
              coatings.
            </p>
            <ul class="check-list">
              <li>Wide photos of the whole floor</li>
              <li>Closeups of cracks, stains, or coatings</li>
              <li>Door thresholds, drains, steps, and edges</li>
              <li>Preferred flake, quartz, metallic, solid, or custom finish</li>
            </ul>
            <div class="inline-actions">
              <a class="button button-secondary" href={business.phoneHref} data-cta="call"
                >Call {business.phoneDisplay}</a
              >
              <a class="button button-secondary" href={business.smsHref} data-cta="text">Text PRVN</a>
            </div>
          </div>
        </aside>

        <form class="quote-panel quote-wizard" id="quote-form" data-quote-form novalidate data-reveal>
          <p class="step-status" data-step-status aria-live="polite">Step 1 of 8: Space type</p>
          <div class="wizard-progress" role="list" aria-label="Quote progress">
            {
              Array.from({ length: 8 }).map((_, index) => (
                <span class:list={[index === 0 ? 'is-active' : '']} data-step-dot={index} />
              ))
            }
          </div>
          <input
            class="honeypot"
            type="text"
            name="companyWebsite"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
            aria-label="Leave this field blank"
          />
          <input type="hidden" name="finishStyle" data-finish-style />

          <div class="wizard-step is-active" data-step="0">
            <h2>What space are you coating?</h2><p>Select the type of project.</p>
            <div class="option-grid">
              {
                [
                  'Residential garage',
                  'Residential interior',
                  'Commercial space',
                  'Industrial / heavy-use',
                  'Countertops',
                  'Other',
                ].map((option) => (
                  <label class="option-card" data-option-card>
                    <input type="radio" name="projectType" value={option} required />
                    {option}
                  </label>
                ))
              }
            </div>
          </div>

          <div class="wizard-step" data-step="1" hidden inert>
            <h2>Which finish interests you?</h2><p>Select a coating system or choose "Not sure yet."</p>
            <div class="option-grid">
              {
                finishFamilies.map((finish) => (
                  <label class="option-card" data-option-card>
                    <input type="radio" name="finishPreference" value={finish.title} required />
                    {finish.shortTitle}
                  </label>
                ))
              }
              {
                services.slice(3).map((service) => (
                  <label class="option-card" data-option-card>
                    <input type="radio" name="finishPreference" value={service.title} required />
                    {service.title}
                  </label>
                ))
              }
              <label class="option-card" data-option-card
                ><input type="radio" name="finishPreference" value="Not sure yet" required />Not sure yet</label
              >
            </div>
          </div>

          <div class="wizard-step" data-step="2" hidden inert>
            <h2>How large is the project?</h2><p>
              Approximate square footage helps PRVN prepare a more accurate estimate.
            </p>
            <div class="form-grid">
              <div class="form-field">
                <label for="squareFeet">Approximate square feet</label><input
                  id="squareFeet"
                  name="squareFeet"
                  inputmode="numeric"
                  pattern="[0-9, ]*"
                  placeholder="Example: 450"
                />
              </div>
            </div>
          </div>

          <div class="wizard-step" data-step="3" hidden inert>
            <h2>What is the current surface?</h2><p>Select the condition that best describes the concrete.</p>
            <div class="option-grid">
              {
                [
                  'Bare concrete',
                  'Painted or previously coated',
                  'Cracks or repairs needed',
                  'Oil, stains, or moisture concerns',
                  'Not sure',
                ].map((option) => (
                  <label class="option-card" data-option-card>
                    <input type="radio" name="surfaceCondition" value={option} />
                    {option}
                  </label>
                ))
              }
            </div>
          </div>

          <div class="wizard-step" data-step="4" hidden inert>
            <h2>Where is the project?</h2><p>PRVN covers the Florida Keys to West Palm Beach.</p>
            <div class="form-grid">
              <div class="form-field">
                <label for="location">Project location <span>Required</span></label><input
                  id="location"
                  name="location"
                  autocomplete="street-address"
                  placeholder="City or address"
                  required
                />
              </div>
            </div>
          </div>

          <div class="wizard-step" data-step="5" hidden inert>
            <h2>What is the preferred timeline?</h2><p>Select when you would like the project to begin.</p>
            <div class="option-grid">
              {
                ['As soon as possible', 'Within 2 weeks', 'This month', 'Planning ahead'].map((option) => (
                  <label class="option-card" data-option-card>
                    <input type="radio" name="timeline" value={option} />
                    {option}
                  </label>
                ))
              }
            </div>
          </div>

          <div class="wizard-step" data-step="6" hidden inert>
            <h2>Contact information</h2><p>PRVN will follow up by phone, text, or email.</p>
            <div class="form-grid">
              <div class="form-field">
                <label for="name">Name <span>Required</span></label><input
                  id="name"
                  name="name"
                  autocomplete="name"
                  required
                />
              </div>
              <div class="form-field">
                <label for="phone">Phone <span>Required</span></label><input
                  id="phone"
                  name="phone"
                  type="tel"
                  inputmode="tel"
                  autocomplete="tel"
                  required
                />
              </div>
              <div class="form-field">
                <label for="email">Email <span>Required</span></label><input
                  id="email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  required
                />
              </div>
            </div>
          </div>

          <div class="wizard-step" data-step="7" hidden inert>
            <h2>Review and submit</h2><p>Confirm your project details before sending the request.</p>
            <dl class="wizard-review" data-review-list>
              {
                [
                  ['Space type', 'projectType'],
                  ['Finish preference', 'finishPreference'],
                  ['Finish style', 'finishStyle'],
                  ['Square feet', 'squareFeet'],
                  ['Surface condition', 'surfaceCondition'],
                  ['Location', 'location'],
                  ['Timeline', 'timeline'],
                  ['Name', 'name'],
                  ['Phone', 'phone'],
                  ['Email', 'email'],
                ].map(([label, field]) => (
                  <div class="review-item">
                    <>
                      <dt>{label}</dt>
                      <dd data-review={field}>Not provided</dd>
                    </>
                  </div>
                ))
              }
            </dl>
            <div class="form-grid">
              <div class="form-field">
                <label for="message">Additional project notes</label><textarea
                  id="message"
                  name="message"
                  placeholder="Tell PRVN about use, color ideas, coatings, cracks, and any photo links."></textarea>
              </div>
              <div class="form-field">
                <label for="photoLinks">Photo links</label><input
                  id="photoLinks"
                  name="photoLinks"
                  placeholder="Google Drive, iCloud, Dropbox, or photo URLs"
                />
              </div>
              {turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="dark" />}
            </div>
          </div>

          <div class="wizard-nav">
            <button class="button button-secondary" type="button" data-prev hidden>Back</button>
            <button class="button" type="button" data-next>Continue</button>
            <button class="button" type="submit" data-submit hidden>Send quote request</button>
          </div>
          <p class="form-status" data-form-status aria-live="polite"></p>
          <div class="quote-success" data-quote-success hidden tabindex="-1">
            <span class="kicker">Request received</span><h2>PRVN will follow up using your contact details.</h2><p>
              If you need faster help, call or text {business.phoneDisplay}.
            </p>
          </div>
          <noscript
            ><p class="form-status is-error">
              JavaScript is required for this wizard. Please call <a href={business.phoneHref}
                >{business.phoneDisplay}</a
              > or email <a href={business.emailHref}>{business.email}</a>.
            </p></noscript
          >
        </form>
      </div>
    </div>
  </section>
</Layout>

{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />}
