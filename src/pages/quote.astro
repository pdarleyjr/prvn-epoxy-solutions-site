---
import { business, finishFamilies, services } from '~/data/site';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Free Epoxy Floor Quote',
  description:
    'Request a PRVN Epoxy Solutions quote for premium epoxy floors from the Florida Keys to West Palm Beach.',
};

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<Layout metadata={metadata}>
  <section class="page-hero" data-section="quote-hero">
    <div class="shell section-heading" data-reveal>
      <span class="kicker">Free quote</span>
      <h1>Tell PRVN what the concrete needs to become.</h1>
      <p>
        Share the floor type, location, finish direction, timeline, and photo links. If the web form is unavailable,
        call or text PRVN directly.
      </p>
    </div>
  </section>

  <section class="section" data-section="quote-form">
    <div class="shell split-grid">
      <form class="quote-panel" id="quote-form" data-quote-form novalidate data-reveal>
        <p class="step-status" data-step-status aria-live="polite">Step 1 of 3: Project</p>
        <div class="quote-steps" role="list" aria-label="Quote progress">
          <span class="is-active" data-step-dot="0"></span>
          <span data-step-dot="1"></span>
          <span data-step-dot="2"></span>
        </div>

        <input
          class="honeypot"
          type="text"
          name="companyWebsite"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
          aria-label="Leave this field blank"
        />

        <fieldset data-step="0" class="is-active" aria-labelledby="quote-step-1">
          <legend class="form-legend" id="quote-step-1" tabindex="-1">Step 1 / Project</legend>
          <div class="form-grid">
            <div class="form-field">
              <label for="projectType">Project type <span>Required</span></label>
              <select id="projectType" name="projectType" required>
                <option value="">Select one</option>
                <option>Residential garage</option>
                <option>Residential interior</option>
                <option>Commercial space</option>
                <option>Industrial / heavy-use</option>
                <option>Countertops</option>
                <option>Other</option>
              </select>
            </div>
            <div class="form-field">
              <label for="finishPreference">Finish preference <span>Required</span></label>
              <select id="finishPreference" name="finishPreference" required>
                <option value="">Select one</option>
                {finishFamilies.map((finish) => <option>{finish.title}</option>)}
                {services.slice(3).map((service) => <option>{service.title}</option>)}
                <option>Not sure yet</option>
              </select>
            </div>
            <div class="form-field">
              <label for="squareFeet">Approx. square feet</label>
              <input
                id="squareFeet"
                name="squareFeet"
                inputmode="numeric"
                pattern="[0-9, ]*"
                placeholder="Example: 450"
              />
            </div>
            <div class="form-field">
              <label for="surfaceCondition">Current concrete condition</label>
              <select id="surfaceCondition" name="surfaceCondition">
                <option value="">Select one</option>
                <option>Bare concrete</option>
                <option>Painted or previously coated</option>
                <option>Cracks or repairs needed</option>
                <option>Oil, stains, or moisture concerns</option>
                <option>Not sure</option>
              </select>
            </div>
          </div>
        </fieldset>

        <fieldset data-step="1" aria-labelledby="quote-step-2">
          <legend class="form-legend" id="quote-step-2" tabindex="-1">Step 2 / Contact</legend>
          <div class="form-grid">
            <div class="form-field">
              <label for="name">Name <span>Required</span></label>
              <input id="name" name="name" autocomplete="name" required />
            </div>
            <div class="form-field">
              <label for="phone">Phone <span>Required</span></label>
              <input id="phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required />
            </div>
            <div class="form-field">
              <label for="email">Email <span>Required</span></label>
              <input id="email" name="email" type="email" autocomplete="email" required />
            </div>
            <div class="form-field">
              <label for="location">Project location <span>Required</span></label>
              <input
                id="location"
                name="location"
                autocomplete="street-address"
                placeholder="City or address"
                required
              />
            </div>
            <div class="form-field">
              <label for="timeline">Desired timeline</label>
              <select id="timeline" name="timeline">
                <option value="">Select one</option>
                <option>As soon as possible</option>
                <option>Within 2 weeks</option>
                <option>This month</option>
                <option>Planning ahead</option>
              </select>
            </div>
          </div>
        </fieldset>

        <fieldset data-step="2" aria-labelledby="quote-step-3">
          <legend class="form-legend" id="quote-step-3" tabindex="-1">Step 3 / Details</legend>
          <div class="form-grid">
            <div class="form-field">
              <label for="message">Project notes <span>Required</span></label>
              <textarea
                id="message"
                name="message"
                placeholder="Tell PRVN about use, color ideas, coatings, cracks, and any photo links."
                required></textarea>
            </div>
            <div class="form-field">
              <label for="photoLinks">Photo links</label>
              <input id="photoLinks" name="photoLinks" placeholder="Google Drive, iCloud, Dropbox, or photo URLs" />
            </div>
            {turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="dark" />}
          </div>
        </fieldset>

        <div class="form-actions">
          <button class="button button-secondary" type="button" data-prev hidden>Back</button>
          <button class="button" type="button" data-next>Next</button>
          <button class="button" type="submit" data-submit hidden>Send quote request</button>
        </div>
        <p class="form-status" data-form-status aria-live="polite"></p>
        <div class="quote-success" data-quote-success hidden tabindex="-1">
          <span class="kicker">Request received</span>
          <h2>PRVN will follow up using your contact details.</h2>
          <p>If you need faster help, call or text {business.phoneDisplay}.</p>
        </div>

        <noscript>
          <p class="form-status is-error">
            JavaScript is required for this wizard. Please call <a href={business.phoneHref}>{business.phoneDisplay}</a>
            or email <a href={business.emailHref}>{business.email}</a>.
          </p>
        </noscript>
      </form>

      <aside class="contact-card" data-reveal>
        <span class="kicker">What helps</span>
        <h2>Photos make the estimate sharper.</h2>
        <p>
          Include square footage, slab photos, finish preference, timeline, and whether the space has existing coatings.
        </p>
        <ul class="check-list">
          <li>Wide photos of the whole floor</li>
          <li>Closeups of cracks, stains, or coatings</li>
          <li>Door thresholds, drains, steps, and edges</li>
          <li>Preferred flake, quartz, metallic, solid, or custom finish</li>
        </ul>
        <div class="inline-actions">
          <a class="button button-secondary" href={business.phoneHref} data-cta="call">Call {business.phoneDisplay}</a>
          <a class="button button-secondary" href={business.smsHref} data-cta="text">Text PRVN</a>
        </div>
      </aside>
    </div>
  </section>
</Layout>

{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />}

<script>
  const form = document.querySelector('[data-quote-form]');

  if (form instanceof HTMLFormElement) {
    const steps = Array.from(form.querySelectorAll('fieldset[data-step]'));
    const dots = Array.from(form.querySelectorAll('[data-step-dot]'));
    const prev = form.querySelector('[data-prev]');
    const next = form.querySelector('[data-next]');
    const submit = form.querySelector('[data-submit]');
    const status = form.querySelector('[data-form-status]');
    const stepStatus = form.querySelector('[data-step-status]');
    const stepTrack = form.querySelector('.quote-steps');
    const success = form.querySelector('[data-quote-success]');
    const stepLabels = ['Project', 'Contact', 'Details'];
    let step = 0;

    const setStatus = (message: string, isError = false) => {
      if (!status) return;
      status.textContent = message;
      status.classList.toggle('is-error', isError);
      status.classList.toggle('is-success', Boolean(message) && !isError);
    };

    const showStep = (focusLegend = false) => {
      steps.forEach((item, index) => {
        const active = index === step;
        item.classList.toggle('is-active', active);
        if (item instanceof HTMLFieldSetElement) item.hidden = !active;
        item.toggleAttribute('inert', !active);
      });
      dots.forEach((item, index) => item.classList.toggle('is-active', index <= step));
      if (prev instanceof HTMLButtonElement) prev.hidden = step === 0;
      if (next instanceof HTMLButtonElement) next.hidden = step === steps.length - 1;
      if (submit instanceof HTMLButtonElement) submit.hidden = step !== steps.length - 1;
      if (stepStatus) stepStatus.textContent = `Step ${step + 1} of ${steps.length}: ${stepLabels[step]}`;
      if (stepTrack instanceof HTMLElement) stepTrack.style.setProperty('--quote-step', String(step + 1));
      setStatus('');
      if (focusLegend) steps[step].querySelector<HTMLElement>('legend')?.focus({ preventScroll: true });
    };

    const currentStepValid = () => {
      const current = steps[step];
      const fields = Array.from(current.querySelectorAll('input, select, textarea'));
      for (const field of fields) {
        if (
          field instanceof HTMLInputElement ||
          field instanceof HTMLSelectElement ||
          field instanceof HTMLTextAreaElement
        ) {
          if (!field.reportValidity()) {
            field.focus();
            return false;
          }
        }
      }
      return true;
    };

    next?.addEventListener('click', () => {
      if (!currentStepValid()) return;
      step = Math.min(step + 1, steps.length - 1);
      showStep(true);
    });

    prev?.addEventListener('click', () => {
      step = Math.max(step - 1, 0);
      showStep(true);
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (step < steps.length - 1) {
        if (!currentStepValid()) return;
        step = Math.min(step + 1, steps.length - 1);
        showStep(true);
        return;
      }
      if (!currentStepValid()) return;
      setStatus('Sending your request...');
      if (submit instanceof HTMLButtonElement) {
        submit.disabled = true;
        submit.textContent = 'Sending...';
      }

      const payload = Object.fromEntries(new FormData(form).entries());

      try {
        const response = await fetch('/api/quote', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || !result.ok) {
          throw new Error(result.message || 'The request could not be sent right now. Please call or text PRVN.');
        }
        form.reset();
        step = 0;
        showStep(false);
        if (success instanceof HTMLElement) {
          success.hidden = false;
          success.focus({ preventScroll: true });
        }
        setStatus('Request sent. PRVN will follow up using the contact details provided.');
      } catch (error) {
        setStatus(
          error instanceof Error ? error.message : 'The request could not be sent right now. Please call or text PRVN.',
          true
        );
      } finally {
        if (submit instanceof HTMLButtonElement) {
          submit.disabled = false;
          submit.textContent = 'Send quote request';
        }
      }
    });

    showStep();
  }
</script>
