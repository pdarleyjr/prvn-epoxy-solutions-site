---
import JsonLd from '~/components/JsonLd.astro';
import {
  benefitCards,
  business,
  configuratorFinishes,
  configuratorSpaces,
  configuratorStyles,
  defaultRecommendation,
  finishFamilies,
  galleryImages,
  processSteps,
  proofPoints,
  serviceAreaCoverage,
  siteUrl,
} from '~/data/site';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'PRVN Epoxy Solutions | Premium Epoxy Floor Coatings',
  ignoreTitleTemplate: true,
  description:
    'PRVN Epoxy Solutions installs premium epoxy floor coatings for residential, commercial, and industrial spaces from the Florida Keys to West Palm Beach.',
};

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': `${siteUrl}/#business`,
  name: business.name,
  description: business.tagline,
  telephone: '+19546554199',
  email: business.email,
  url: `${siteUrl}/`,
  logo: `${siteUrl}/assets/prvn-logo.png`,
  image: `${siteUrl}/assets/og-prvn-epoxy.jpg`,
  priceRange: '$$',
  areaServed: serviceAreaCoverage.schema,
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+19546554199',
    email: business.email,
    contactType: 'sales',
    areaServed: serviceAreaCoverage.summary,
  },
  makesOffer: finishFamilies.map((finish) => ({
    '@type': 'Offer',
    itemOffered: {
      '@type': 'Service',
      name: finish.title,
      description: finish.description,
    },
  })),
};
---

<Layout metadata={metadata}>
  <JsonLd data={localBusinessSchema} />

  <section class="hero" data-section="hero">
    <div class="hero-grid shell">
      <div class="hero-media" aria-label="PRVN epoxy floor finish preview" data-hero-media>
        <picture>
          <source srcset="/assets/hero-floor-1600.avif" type="image/avif" media="(min-width: 900px)" />
          <source srcset="/assets/hero-floor-1600.webp" type="image/webp" media="(min-width: 900px)" />
          <source srcset="/assets/hero-floor-800.webp" type="image/webp" />
          <img
            src="/assets/hero-floor-1200.webp"
            alt="Premium glossy epoxy floor finish"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            width="1600"
            height="686"
          />
        </picture>
      </div>

      <div class="hero-copy">
        <div class="hero-title-block" data-reveal>
          <span class="eyebrow">Premium epoxy coating systems</span>
          <h1 transition:name="home-headline">Gloss, grit, and concrete armor.</h1>
        </div>
        <div class="hero-support" data-reveal data-reveal-delay="0.08">
          <p>
            PRVN installs premium coating systems for garages, homes, shops, showrooms, and commercial spaces from the
            Florida Keys to West Palm Beach.
          </p>
          <div class="hero-actions">
            <a class="button" href="/quote" data-cta="quote" data-magnetic>Get a free quote</a>
            <a class="button button-secondary" href={business.phoneHref} data-cta="call">{business.phoneDisplay}</a>
          </div>
          <div class="hero-proof" aria-label="PRVN proof points">
            {
              proofPoints.map((point, index) => (
                <div class="proof-card" data-reveal data-reveal-delay={0.1 + index * 0.06}>
                  {typeof point.value === 'number' ? (
                    <strong data-counter={point.value} data-counter-suffix={point.suffix}>
                      {point.value}
                      {point.suffix}
                    </strong>
                  ) : (
                    <strong>{point.display}</strong>
                  )}
                  <span>{point.label}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-systems" id="systems" aria-labelledby="systems-title" data-section="systems">
    <div class="shell">
      <div class="section-heading" data-reveal>
        <span class="kicker">Floor Systems</span>
        <h2 id="systems-title">Engineered coating systems.</h2>
        <p>
          Each system starts with concrete prep and ends with a finish selected for traction, gloss, maintenance, and
          the way the space gets used.
        </p>
      </div>
    </div>
    <div class="finish-scroll" data-finish-scroll>
      {
        finishFamilies.map((finish, index) => (
          <article class="finish-card" id={finish.id} data-reveal data-reveal-delay={index * 0.06}>
            <picture>
              <source srcset={finish.avif} type="image/avif" />
              <img
                src={finish.image}
                alt={`${finish.title} floor coating sample`}
                loading="lazy"
                decoding="async"
                width="900"
                height="900"
              />
            </picture>
            <span class="kicker">{finish.bestUses}</span>
            <h3>{finish.title}</h3>
            <p>{finish.description}</p>
            <ul>
              {finish.qualities.map((quality) => (
                <li>{quality}</li>
              ))}
            </ul>
            <div class="finish-card-actions">
              <a class="button button-secondary button-small" href={finish.href}>View System</a>
              <a class="button button-small" href={`/quote?finish=${finish.id}`}>Start Quote</a>
            </div>
          </article>
        ))
      }
    </div>
    <div class="finish-dots" data-finish-dots aria-hidden="true">
      {finishFamilies.map((_, index) => <span class:list={[index === 0 ? 'is-active' : '']} />)}
    </div>
  </section>

  <section class="section" aria-labelledby="before-after-title" data-section="before-after">
    <div class="shell split-grid">
      <div class="section-heading" data-reveal>
        <span class="kicker">Before / After</span>
        <h2 id="before-after-title">From bare slab to showroom finish.</h2>
        <p>
          Drag the slider to compare a real project before and after the PRVN epoxy coating is complete.
        </p>
        <a class="button button-secondary" href="/gallery" data-cta="gallery">View Projects</a>
      </div>
      <div class="ba-slider" data-before-after data-reveal style="--split: 52%;">
        <div class="ba-after">
          <img
            src="/assets/after-job.webp"
            alt="Completed PRVN epoxy floor after coating"
            loading="lazy"
            decoding="async"
            width="1400"
            height="1050"
          />
        </div>
        <div class="ba-before">
          <img
            src="/assets/before-job.webp"
            alt="Epoxy floor job in progress before completion"
            loading="lazy"
            decoding="async"
            width="1400"
            height="1050"
          />
        </div>
        <input class="ba-range" type="range" min="8" max="92" value="52" aria-label="Compare before and after floor" />
        <div class="ba-handle" aria-hidden="true"><span></span></div>
        <div class="ba-labels" aria-hidden="true">
          <span>Before</span>
          <span>After</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="benefits-title" data-section="benefits">
    <div class="shell">
      <div class="section-heading" data-reveal>
        <span class="kicker">Why PRVN</span>
        <h2 id="benefits-title">A floor that looks expensive because it works hard.</h2>
      </div>
      <div class="metrics-grid">
        {
          benefitCards.map((card, index) => (
            <article class="metric-card" data-reveal data-reveal-delay={index * 0.06}>
              <h3>{card.title}</h3>
              <p>{card.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="process" aria-labelledby="process-title" data-section="process">
    <div class="shell">
      <div class="section-heading" data-reveal>
        <span class="kicker">Process</span>
        <h2 id="process-title">Clear steps. Clean handoff.</h2>
      </div>
      <div class="timeline" data-process-timeline>
        {
          processSteps.map((step, index) => (
            <article data-reveal data-reveal-delay={index * 0.07}>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="gallery" aria-labelledby="gallery-title" data-section="gallery">
    <div class="shell">
      <div class="section-heading" data-reveal>
        <span class="kicker">Gallery</span>
        <h2 id="gallery-title">Finish ideas with depth, chip, and gloss.</h2>
        <p>Current PRVN finish imagery for Flakes, Quartz, Metallic, Solid, and Carbon Fiber epoxy looks.</p>
      </div>
      <div class="gallery-grid">
        {
          galleryImages.slice(0, 5).map((image) => (
            <button
              class="gallery-item"
              type="button"
              data-gallery-item
              data-full={image.full}
              data-alt={image.alt}
              data-caption={image.caption}
              data-badge={image.badge}
              data-categories={image.categories.join(',')}
              data-reveal
            >
              <img
                src={image.src}
                alt={image.alt}
                loading="lazy"
                decoding="async"
                width={image.width}
                height={image.height}
              />
              <span>{image.badge}</span>
            </button>
          ))
        }
      </div>
      <div class="inline-actions gallery-preview-actions" data-reveal>
        <a class="button button-secondary" href="/gallery" data-cta="gallery">View Full Gallery</a>
      </div>
    </div>
  </section>

  <section class="section" id="find-finish" aria-labelledby="find-finish-title" data-section="find-finish">
    <div class="shell">
      <div class="section-heading" data-reveal>
        <span class="kicker">Configurator</span>
        <h2 id="find-finish-title">Find Your Finish.</h2>
        <p>Select your space, finish type, and style direction to see a recommended PRVN system.</p>
      </div>
      <div class="find-finish" data-find-finish data-reveal>
        <div class="find-finish-grid">
          <div class="find-finish-selectors">
            <div class="selector-group" data-selector-group="space">
              <h3>Space</h3>
              <div class="selector-options">
                {
                  configuratorSpaces.map((option, index) => (
                    <button
                      class="selector-button"
                      type="button"
                      data-selector="space"
                      data-value={option.id}
                      aria-pressed={index === 0 ? 'true' : 'false'}
                      class:list={[index === 0 ? 'is-selected' : '']}
                    >
                      {option.label}
                    </button>
                  ))
                }
              </div>
            </div>
            <div class="selector-group" data-selector-group="finish">
              <h3>Finish</h3>
              <div class="selector-options">
                {
                  configuratorFinishes.map((option, index) => (
                    <button
                      class="selector-button"
                      type="button"
                      data-selector="finish"
                      data-value={option.id}
                      aria-pressed={index === 0 ? 'true' : 'false'}
                      class:list={[index === 0 ? 'is-selected' : '']}
                    >
                      {option.label}
                    </button>
                  ))
                }
              </div>
            </div>
            <div class="selector-group" data-selector-group="style">
              <h3>Style</h3>
              <div class="selector-options">
                {
                  configuratorStyles.map((option, index) => (
                    <button
                      class="selector-button"
                      type="button"
                      data-selector="style"
                      data-value={option.id}
                      aria-pressed={index === 0 ? 'true' : 'false'}
                      class:list={[index === 0 ? 'is-selected' : '']}
                    >
                      {option.label}
                    </button>
                  ))
                }
              </div>
            </div>
          </div>
          <div class="find-finish-result" data-finish-result>
            <img
              src={defaultRecommendation.image}
              alt="Recommended finish preview"
              data-result-image
              loading="lazy"
              decoding="async"
              width="600"
              height="400"
            />
            <h3 data-result-system>{defaultRecommendation.system}</h3>
            <p data-result-description>{defaultRecommendation.description}</p>
            <p>
              <strong>Ideal for:</strong>
              {' '}
              <span data-result-uses>{defaultRecommendation.uses}</span>
            </p>
            <a class="button" href="/quote" data-result-quote>Start Quote With This Finish</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="cta-title" data-section="final-cta">
    <div class="shell final-cta">
      <span class="kicker">Free estimate</span>
      <h2 id="cta-title">Ready to transform your space?</h2>
      <p class="lede">Start a free project estimate. Share your finish preference, photos, square footage, and timeline.</p>
      <div class="inline-actions">
        <a class="button" href="/quote" data-cta="quote" data-magnetic>Start Quote</a>
        <a class="button button-secondary" href={business.phoneHref} data-cta="call">Call PRVN</a>
        <a class="button button-secondary" href={business.smsHref} data-cta="text">Text PRVN</a>
      </div>
    </div>
  </section>
</Layout>
