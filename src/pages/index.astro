---
import JsonLd from '~/components/JsonLd.astro';
import StickyMobileCTA from '~/components/StickyMobileCTA.astro';
import { business, finishFamilies, galleryImages, processSteps } from '~/data/site';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Premium Epoxy Floor Coatings',
  ignoreTitleTemplate: true,
  description:
    'PRVN Epoxy Solutions installs premium epoxy floor coatings for residential, commercial, and industrial spaces. Call, email, or text for a free estimate.',
};

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: business.name,
  description: business.tagline,
  telephone: business.phoneDisplay,
  email: business.email,
  url: 'https://prvn-epoxy-solutions-site.pages.dev/',
  image: 'https://prvn-epoxy-solutions-site.pages.dev/assets/og-prvn-epoxy.jpg',
  priceRange: '$$',
  areaServed: 'Service area pending confirmation',
  makesOffer: finishFamilies.map((finish) => ({
    '@type': 'Offer',
    itemOffered: {
      '@type': 'Service',
      name: finish.title,
      description: finish.description,
    },
  })),
};
---

<Layout metadata={metadata}>
  <JsonLd data={localBusinessSchema} />

  <section class="hero">
    <div class="hero-grid shell">
      <div>
        <span class="eyebrow">New epoxy flake floors in as little as 24 hours</span>
        <h1>Gloss, grit, and concrete armor.</h1>
        <p>
          PRVN Epoxy Solutions installs premium coating systems for garages, homes, shops, showrooms, and high-use
          commercial spaces. Call, email, or text for a free estimate.
        </p>
        <div class="hero-actions">
          <a class="button" href="/quote">Start a free quote</a>
          <a class="button button-secondary" href={business.phoneHref}>{business.phoneDisplay}</a>
        </div>
        <div class="hero-proof" aria-label="PRVN proof points">
          <div class="proof-card">
            <strong>24 hr</strong>
            <span>Flake floor install options after prep review</span>
          </div>
          <div class="proof-card">
            <strong>3 ways</strong>
            <span>Call, text, or email for a free estimate</span>
          </div>
          <div class="proof-card">
            <strong>R / C / I</strong>
            <span>Residential, commercial, and industrial coatings</span>
          </div>
        </div>
      </div>

      <div class="hero-media" aria-label="PRVN epoxy floor finish preview">
        <picture>
          <source srcset="/assets/hero-floor-1600.avif" type="image/avif" media="(min-width: 900px)" />
          <source srcset="/assets/hero-floor-1600.webp" type="image/webp" media="(min-width: 900px)" />
          <source srcset="/assets/hero-floor-800.webp" type="image/webp" />
          <img
            src="/assets/hero-floor-1200.webp"
            alt="Premium glossy epoxy floor finish"
            loading="eager"
            decoding="async"
          />
        </picture>
        <picture class="machine-cutout" aria-hidden="true">
          <source srcset="/assets/prvn-machine.webp" type="image/webp" media="(min-width: 720px)" />
          <source srcset="/assets/prvn-machine-mobile.webp" type="image/webp" />
          <img src="/assets/prvn-machine.png" alt="" loading="eager" decoding="async" />
        </picture>
        <div class="media-badge">
          <strong>Decorative concrete coating technology</strong>
          <span>Flake, quartz, solid, metallic, glitter, countertops, and logo detail systems.</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="styles" aria-labelledby="styles-title">
    <div class="shell">
      <div class="section-heading">
        <span class="kicker">Epoxy styles</span>
        <h2 id="styles-title">Choose the finish that fits the room.</h2>
        <p>
          Every system starts with concrete prep and ends with a finish selected for traction, gloss, maintenance, and
          the way the space gets used.
        </p>
      </div>
      <div class="styles-grid">
        {
          finishFamilies.map((finish) => (
            <article class="service-card" id={finish.id}>
              <picture>
                <source srcset={finish.avif} type="image/avif" />
                <img src={finish.image} alt={`${finish.title} floor coating sample`} loading="lazy" decoding="async" />
              </picture>
              <h3>{finish.title}</h3>
              <p>{finish.description}</p>
              <ul>
                {finish.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="before-after-title">
    <div class="shell split-grid">
      <div class="section-heading">
        <span class="kicker">Before / after</span>
        <h2 id="before-after-title">From bare slab to showroom finish.</h2>
        <p>
          Drag the slider to compare a real job in progress with the finished PRVN epoxy coating after the floor is
          complete.
        </p>
      </div>
      <div class="ba-slider" data-before-after style="--split: 52%;">
        <div class="ba-after">
          <img
            src="/assets/after-job.webp"
            alt="Completed PRVN epoxy floor after coating"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="ba-before">
          <img
            src="/assets/before-job.webp"
            alt="Epoxy floor job in progress before completion"
            loading="lazy"
            decoding="async"
          />
        </div>
        <input class="ba-range" type="range" min="8" max="92" value="52" aria-label="Compare before and after floor" />
        <div class="ba-handle" aria-hidden="true">&lt;&gt;</div>
        <div class="ba-labels" aria-hidden="true">
          <span>Before</span>
          <span>After</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="proof-title">
    <div class="shell">
      <div class="section-heading">
        <span class="kicker">Why PRVN / why epoxy</span>
        <h2 id="proof-title">A floor that looks expensive because it works hard.</h2>
      </div>
      <div class="metrics-grid">
        <article class="metric-card">
          <h3>Concrete prep first</h3>
          <p>Grinding, cleaning, repair review, and profile control help the coating bond correctly.</p>
        </article>
        <article class="metric-card">
          <h3>Finish systems by use</h3>
          <p>
            Flake, quartz, metallic, solid, glitter, countertop, and logo options give each space a purpose-built look.
          </p>
        </article>
        <article class="metric-card">
          <h3>Easy to maintain</h3>
          <p>A sealed epoxy system helps reduce dusting concrete, stains, and the unfinished garage feel.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" id="process" aria-labelledby="process-title">
    <div class="shell">
      <div class="section-heading">
        <span class="kicker">Process</span>
        <h2 id="process-title">Clear steps. Clean handoff.</h2>
      </div>
      <div class="timeline">
        {
          processSteps.map((step) => (
            <article>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="gallery" aria-labelledby="gallery-title">
    <div class="shell">
      <div class="section-heading">
        <span class="kicker">Gallery preview</span>
        <h2 id="gallery-title">Finish ideas with depth, chip, and gloss.</h2>
        <p>Current PRVN project and concept imagery, arranged to preserve each image without cropping.</p>
      </div>
      <div class="gallery-grid">
        {galleryImages.map((image) => <img src={image.src} alt={image.alt} loading="lazy" decoding="async" />)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="cta-title">
    <div class="shell final-cta">
      <span class="kicker">Free estimate</span>
      <h2 id="cta-title">Ready for a floor that looks finished on purpose?</h2>
      <p class="lede">
        Share your finish preference, photos, square footage, and timeline. PRVN will follow up by phone, text, or
        email.
      </p>
      <div class="inline-actions">
        <a class="button" href="/quote">Start quote wizard</a>
        <a class="button button-secondary" href={business.emailHref}>Email PRVN</a>
      </div>
    </div>
  </section>

  <StickyMobileCTA />
</Layout>

<script>
  document.querySelectorAll('[data-before-after]').forEach((slider) => {
    const input = slider.querySelector('input[type="range"]');
    if (!(input instanceof HTMLInputElement)) return;
    const sync = () => slider.setAttribute('style', `--split: ${input.value}%;`);
    input.addEventListener('input', sync);
    sync();
  });
</script>
