---
import { processSteps, business } from '~/data/site';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Epoxy Floor Installation Process',
  description:
    'See the PRVN Epoxy Solutions process from inspection and concrete prep through coating, protection, and final walkthrough.',
};
---

<Layout metadata={metadata}>
  <section class="page-hero" data-section="process-hero">
    <div class="shell section-heading" data-reveal>
      <span class="kicker">Process</span>
      <h1>Premium epoxy starts before the first coat.</h1>
      <p>
        The final gloss depends on the prep. PRVN uses a clear workflow to assess the slab, select the coating system,
        install cleanly, and communicate cure expectations.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="shell timeline" data-process-timeline>
      {
        processSteps.map((step, index) => (
          <article data-reveal data-reveal-delay={index * 0.07}>
            <h2>{step.title}</h2>
            <p>{step.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="shell final-cta">
      <span class="kicker">Free estimate</span>
      <h2>Send photos before you schedule.</h2>
      <p class="lede">Photos help identify cracks, coatings, stains, joints, and prep conditions before pricing.</p>
      <div class="inline-actions">
        <a class="button" href="/quote" data-cta="quote" data-magnetic>Start quote wizard</a>
        <a class="button button-secondary" href={business.phoneHref} data-cta="call">Call PRVN</a>
      </div>
    </div>
  </section>
</Layout>
