---
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/source-serif-4';
---

<style is:inline>
  :root {
    --aw-font-sans: 'Space Grotesk Variable';
    --aw-font-serif: 'Source Serif 4 Variable';
    --aw-font-heading: 'Space Grotesk Variable';

    --aw-color-primary: oklch(0.58 0.24 262);
    --aw-color-secondary: oklch(0.47 0.2 262);
    --aw-color-accent: oklch(0.83 0.02 246);

    --aw-color-text-heading: oklch(0.96 0.015 250);
    --aw-color-text-default: oklch(0.89 0.02 250);
    --aw-color-text-muted: oklch(0.71 0.025 250);
    --aw-color-bg-page: oklch(0.12 0.015 250);
    --aw-color-bg-page-dark: oklch(0.09 0.015 250);

    color-scheme: dark;
  }

  ::selection {
    background: oklch(0.58 0.24 262 / 0.42);
    color: oklch(0.98 0.01 250);
  }
</style>
