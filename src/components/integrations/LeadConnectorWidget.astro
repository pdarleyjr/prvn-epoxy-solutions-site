---
import { isLeadConnectorPublicRoute, resolveLeadConnectorConfig } from '~/utils/leadconnector';

interface Props {
  allowed?: boolean;
}

const config = resolveLeadConnectorConfig(import.meta.env);
const publicRoute = Astro.props.allowed !== false && isLeadConnectorPublicRoute(Astro.url.pathname);
if (import.meta.env.DEV && publicRoute && config.warning) console.warn(config.warning);
---

{
  publicRoute && config.enabled && (
    <>
      {config.embed === 'legacy' ? (
        <chat-widget location-id={config.locationId} />
      ) : (
        <div data-chat-widget data-widget-id={config.widgetId} data-location-id={config.locationId} />
      )}
      <script
        is:inline
        src="https://widgets.leadconnectorhq.com/loader.js"
        data-resources-url="https://widgets.leadconnectorhq.com/chat-widget/loader.js"
        data-widget-id={config.embed === 'gtm' ? config.widgetId : undefined}
      />
    </>
  )
}
